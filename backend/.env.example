PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geoslide

# Login admin (modul auth). Ganti dengan string acak yang panjang.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=8h

# Folder foto orang hilang (relatif terhadap folder backend)
UPLOAD_DIR=uploads
